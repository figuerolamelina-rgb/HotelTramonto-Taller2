  "definiciones_sql": {
    "sp_Habitacion_ConsultarDisponibilidad": "PROCEDURESP_HABITACION_CONSULTARDISPONIBILIDAD@FECHA_ENTRADADATE,@FECHA_SALIDADATEASBEGINSETNOCOUNTONSELECTH.ID_HABITACION,H.NUMERO,H.PISO,H.ESTADO,TH.ID_TIPOHABITACION,TH.NOMBREASTIPO_HABITACION,TH.PRECIO_NOCHE,TH.CAPACIDADFROMHABITACIONESHINNERJOINTIPOSHABITACIONTHONH.TIPO_HABITACION=TH.ID_TIPOHABITACIONWHEREH.ACTIVO=1ANDTH.ACTIVO=1ANDH.ESTADO<>'MANTENIMIENTO'ANDNOTEXISTS(SELECT1FROMDETALLERESERVASDRINNERJOINRESERVASRONDR.ID_RESERVA=R.ID_RESERVAWHEREDR.ID_HABITACION=H.ID_HABITACIONANDR.ESTADOIN('CONFIRMADA','CHECKIN')ANDR.FECHA_ENTRADA<@FECHA_SALIDAANDR.FECHA_SALIDA>@FECHA_ENTRADA)ORDERBYH.NUMEROEND",
    "sp_Habitacion_Desactivar": "PROCEDURESP_HABITACION_DESACTIVAR@ID_HABITACIONINTASBEGINSETNOCOUNTONUPDATEHABITACIONESSETACTIVO=0WHEREID_HABITACION=@ID_HABITACIONEND",
