  "definiciones_sql": {
    "sp_Habitacion_ConsultarDisponibilidad": "PROCEDURESP_HABITACION_CONSULTARDISPONIBILIDAD@FECHA_ENTRADADATE,@FECHA_SALIDADATEASBEGINSETNOCOUNTONSELECTH.ID_HABITACION,H.NUMERO,H.PISO,H.ESTADO,TH.ID_TIPOHABITACION,TH.NOMBREASTIPO_HABITACION,TH.PRECIO_NOCHE,TH.CAPACIDADFROMHABITACIONESHINNERJOINTIPOSHABITACIONTHONH.TIPO_HABITACION=TH.ID_TIPOHABITACIONWHEREH.ACTIVO=1ANDTH.ACTIVO=1ANDH.ESTADO<>'MANTENIMIENTO'ANDNOTEXISTS(SELECT1FROMDETALLERESERVASDRINNERJOINRESERVASRONDR.ID_RESERVA=R.ID_RESERVAWHEREDR.ID_HABITACION=H.ID_HABITACIONANDR.ESTADOIN('CONFIRMADA','CHECKIN')ANDR.FECHA_ENTRADA<@FECHA_SALIDAANDR.FECHA_SALIDA>@FECHA_ENTRADA)ORDERBYH.NUMEROEND",
    "sp_Habitacion_Desactivar": "PROCEDURESP_HABITACION_DESACTIVAR@ID_HABITACIONINTASBEGINSETNOCOUNTONUPDATEHABITACIONESSETACTIVO=0WHEREID_HABITACION=@ID_HABITACIONEND",
    "sp_Habitacion_Insertar": "PROCEDURESP_HABITACION_INSERTAR@TIPO_HABITACIONINT,@PISOINT=NULL,@NUMEROVARCHAR(10),@ESTADOVARCHAR(20)ASBEGINSETNOCOUNTONINSERTINTOHABITACIONES(TIPO_HABITACION,PISO,NUMERO,ESTADO)VALUES(@TIPO_HABITACION,@PISO,@NUMERO,@ESTADO)END",
    "sp_Habitacion_Listar": "PROCEDURESP_HABITACION_LISTARASBEGINSETNOCOUNTONSELECTH.ID_HABITACION,H.TIPO_HABITACION,T.NOMBREASTIPO,H.PISO,H.NUMERO,H.ESTADO,H.ACTIVOFROMHABITACIONESHINNERJOINTIPOSHABITACIONTONH.TIPO_HABITACION=T.ID_TIPOHABITACIONWHEREH.ACTIVO=1ORDERBYH.NUMEROEND",
    "sp_Habitacion_ListarInactivas": "PROCEDURESP_HABITACION_LISTARINACTIVASASBEGINSETNOCOUNTONSELECTH.ID_HABITACION,H.TIPO_HABITACION,T.NOMBREASTIPO,H.PISO,H.NUMERO,H.ESTADO,H.ACTIVOFROMHABITACIONESHINNERJOINTIPOSHABITACIONTONT.ID_TIPOHABITACION=H.TIPO_HABITACIONWHEREH.ACTIVO=0ORDERBYH.NUMEROEND",
    "sp_Habitacion_Modificar": "PROCEDURESP_HABITACION_MODIFICAR@ID_HABITACIONINT,@TIPO_HABITACIONINT,@PISOINT=NULL,@NUMEROVARCHAR(10),@ESTADOVARCHAR(20)ASBEGINSETNOCOUNTONUPDATEHABITACIONESSETTIPO_HABITACION=@TIPO_HABITACION,PISO=@PISO,NUMERO=@NUMERO,ESTADO=@ESTADOWHEREID_HABITACION=@ID_HABITACIONEND",
    "sp_Habitacion_Reactivar": "PROCEDURESP_HABITACION_REACTIVAR@ID_HABITACIONINTASBEGINSETNOCOUNTONIFNOTEXISTS(SELECT1FROMHABITACIONESWHEREID_HABITACION=@ID_HABITACION)THROW51002,'LAHABITACIÓNNOEXISTE.',1UPDATEHABITACIONESSETACTIVO=1WHEREID_HABITACION=@ID_HABITACIONEND",
    "sp_Servicio_Desactivar": "PROCEDURESP_SERVICIO_DESACTIVAR@ID_SERVICIOINTASBEGINSETNOCOUNTONUPDATESERVICIOSSETACTIVO=0WHEREID_SERVICIO=@ID_SERVICIOEND",
