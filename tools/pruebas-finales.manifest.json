  "definiciones_sql": {
    "sp_Habitacion_ConsultarDisponibilidad": "PROCEDURESP_HABITACION_CONSULTARDISPONIBILIDAD@FECHA_ENTRADADATE,@FECHA_SALIDADATEASBEGINSETNOCOUNTONSELECTH.ID_HABITACION,H.NUMERO,H.PISO,H.ESTADO,TH.ID_TIPOHABITACION,TH.NOMBREASTIPO_HABITACION,TH.PRECIO_NOCHE,TH.CAPACIDADFROMHABITACIONESHINNERJOINTIPOSHABITACIONTHONH.TIPO_HABITACION=TH.ID_TIPOHABITACIONWHEREH.ACTIVO=1ANDTH.ACTIVO=1ANDH.ESTADO<>'MANTENIMIENTO'ANDNOTEXISTS(SELECT1FROMDETALLERESERVASDRINNERJOINRESERVASRONDR.ID_RESERVA=R.ID_RESERVAWHEREDR.ID_HABITACION=H.ID_HABITACIONANDR.ESTADOIN('CONFIRMADA','CHECKIN')ANDR.FECHA_ENTRADA<@FECHA_SALIDAANDR.FECHA_SALIDA>@FECHA_ENTRADA)ORDERBYH.NUMEROEND",
    "sp_Habitacion_Desactivar": "PROCEDURESP_HABITACION_DESACTIVAR@ID_HABITACIONINTASBEGINSETNOCOUNTONUPDATEHABITACIONESSETACTIVO=0WHEREID_HABITACION=@ID_HABITACIONEND",
    "sp_Habitacion_Insertar": "PROCEDURESP_HABITACION_INSERTAR@TIPO_HABITACIONINT,@PISOINT=NULL,@NUMEROVARCHAR(10),@ESTADOVARCHAR(20)ASBEGINSETNOCOUNTONINSERTINTOHABITACIONES(TIPO_HABITACION,PISO,NUMERO,ESTADO)VALUES(@TIPO_HABITACION,@PISO,@NUMERO,@ESTADO)END",
    "sp_Habitacion_Listar": "PROCEDURESP_HABITACION_LISTARASBEGINSETNOCOUNTONSELECTH.ID_HABITACION,H.TIPO_HABITACION,T.NOMBREASTIPO,H.PISO,H.NUMERO,H.ESTADO,H.ACTIVOFROMHABITACIONESHINNERJOINTIPOSHABITACIONTONH.TIPO_HABITACION=T.ID_TIPOHABITACIONWHEREH.ACTIVO=1ORDERBYH.NUMEROEND",
    "sp_Habitacion_ListarInactivas": "PROCEDURESP_HABITACION_LISTARINACTIVASASBEGINSETNOCOUNTONSELECTH.ID_HABITACION,H.TIPO_HABITACION,T.NOMBREASTIPO,H.PISO,H.NUMERO,H.ESTADO,H.ACTIVOFROMHABITACIONESHINNERJOINTIPOSHABITACIONTONT.ID_TIPOHABITACION=H.TIPO_HABITACIONWHEREH.ACTIVO=0ORDERBYH.NUMEROEND",
    "sp_Habitacion_Modificar": "PROCEDURESP_HABITACION_MODIFICAR@ID_HABITACIONINT,@TIPO_HABITACIONINT,@PISOINT=NULL,@NUMEROVARCHAR(10),@ESTADOVARCHAR(20)ASBEGINSETNOCOUNTONUPDATEHABITACIONESSETTIPO_HABITACION=@TIPO_HABITACION,PISO=@PISO,NUMERO=@NUMERO,ESTADO=@ESTADOWHEREID_HABITACION=@ID_HABITACIONEND",
    "sp_Habitacion_Reactivar": "PROCEDURESP_HABITACION_REACTIVAR@ID_HABITACIONINTASBEGINSETNOCOUNTONIFNOTEXISTS(SELECT1FROMHABITACIONESWHEREID_HABITACION=@ID_HABITACION)THROW51002,'LAHABITACIÓNNOEXISTE.',1UPDATEHABITACIONESSETACTIVO=1WHEREID_HABITACION=@ID_HABITACIONEND",
    "sp_Servicio_Desactivar": "PROCEDURESP_SERVICIO_DESACTIVAR@ID_SERVICIOINTASBEGINSETNOCOUNTONUPDATESERVICIOSSETACTIVO=0WHEREID_SERVICIO=@ID_SERVICIOEND",
    "sp_Servicio_Insertar": "PROCEDURESP_SERVICIO_INSERTAR@NOMBREVARCHAR(50),@DESCRIPCIONVARCHAR(150)=NULL,@PRECIODECIMAL(10,2),@CATEGORIAVARCHAR(30)ASBEGINSETNOCOUNTONIF@CATEGORIAISNULLOR@CATEGORIACOLLATELATIN1_GENERAL_100_BIN2NOTIN('ALMUERZO','MERIENDA','CENA','TRAGOS','PESCAGUIADA','INCLUIDO','OTROS')ORDATALENGTH(@CATEGORIA)<>DATALENGTH(RTRIM(@CATEGORIA))THROW51130,'SELECCIONÁUNACATEGORÍAVÁLIDA.',1INSERTINTOSERVICIOS(NOMBRE,DESCRIPCION,PRECIO,CATEGORIA)VALUES(@NOMBRE,@DESCRIPCION,@PRECIO,@CATEGORIA)END",
    "sp_Servicio_Listar": "PROCEDURESP_SERVICIO_LISTARASBEGINSETNOCOUNTONSELECTID_SERVICIO,NOMBRE,DESCRIPCION,CATEGORIA,PRECIO,ACTIVOFROMSERVICIOSWHEREACTIVO=1ORDERBYNOMBREEND",
    "sp_Servicio_ListarInactivos": "PROCEDURESP_SERVICIO_LISTARINACTIVOSASBEGINSETNOCOUNTONSELECTID_SERVICIO,NOMBRE,DESCRIPCION,CATEGORIA,PRECIO,ACTIVOFROMSERVICIOSWHEREACTIVO=0ORDERBYNOMBREEND",
    "sp_Servicio_Modificar": "PROCEDURESP_SERVICIO_MODIFICAR@ID_SERVICIOINT,@NOMBREVARCHAR(50),@DESCRIPCIONVARCHAR(150)=NULL,@PRECIODECIMAL(10,2),@CATEGORIAVARCHAR(30)ASBEGINSETNOCOUNTONIF@CATEGORIAISNULLOR@CATEGORIACOLLATELATIN1_GENERAL_100_BIN2NOTIN('ALMUERZO','MERIENDA','CENA','TRAGOS','PESCAGUIADA','INCLUIDO','OTROS')ORDATALENGTH(@CATEGORIA)<>DATALENGTH(RTRIM(@CATEGORIA))THROW51130,'SELECCIONÁUNACATEGORÍAVÁLIDA.',1UPDATESERVICIOSSETNOMBRE=@NOMBRE,DESCRIPCION=@DESCRIPCION,PRECIO=@PRECIO,CATEGORIA=@CATEGORIAWHEREID_SERVICIO=@ID_SERVICIOEND",
    "sp_Servicio_Reactivar": "PROCEDURESP_SERVICIO_REACTIVAR@ID_SERVICIOINTASBEGINSETNOCOUNTONIF@ID_SERVICIOISNULLOR@ID_SERVICIO<=0THROW51004,'ELSERVICIONOESVÁLIDO.',1UPDATESERVICIOSSETACTIVO=1WHEREID_SERVICIO=@ID_SERVICIOIF@@ROWCOUNT=0THROW51005,'ELSERVICIONOEXISTE.',1END",
    "sp_TipoHabitacion_Desactivar": "PROCEDURESP_TIPOHABITACION_DESACTIVAR@ID_TIPOHABITACIONINTASBEGINSETNOCOUNTONUPDATETIPOSHABITACIONSETACTIVO=0WHEREID_TIPOHABITACION=@ID_TIPOHABITACIONEND",
    "sp_TipoHabitacion_Insertar": "PROCEDURESP_TIPOHABITACION_INSERTAR@NOMBREVARCHAR(50),@DESCRIPCIONVARCHAR(200)=NULL,@PRECIO_NOCHEDECIMAL(10,2),@CAPACIDADINTASBEGINSETNOCOUNTONINSERTINTOTIPOSHABITACION(NOMBRE,DESCRIPCION,PRECIO_NOCHE,CAPACIDAD)VALUES(@NOMBRE,@DESCRIPCION,@PRECIO_NOCHE,@CAPACIDAD)END",
    "sp_TipoHabitacion_Listar": "PROCEDURESP_TIPOHABITACION_LISTARASBEGINSETNOCOUNTONSELECTID_TIPOHABITACION,NOMBRE,DESCRIPCION,PRECIO_NOCHE,CAPACIDAD,ACTIVOFROMTIPOSHABITACIONWHEREACTIVO=1ORDERBYNOMBREEND",
    "sp_TipoHabitacion_Modificar": "PROCEDURESP_TIPOHABITACION_MODIFICAR@ID_TIPOHABITACIONINT,@NOMBREVARCHAR(50),@DESCRIPCIONVARCHAR(200)=NULL,@PRECIO_NOCHEDECIMAL(10,2),@CAPACIDADINTASBEGINSETNOCOUNTONUPDATETIPOSHABITACIONSETNOMBRE=@NOMBRE,DESCRIPCION=@DESCRIPCION,PRECIO_NOCHE=@PRECIO_NOCHE,CAPACIDAD=@CAPACIDADWHEREID_TIPOHABITACION=@ID_TIPOHABITACIONEND",
    "sp_Usuario_BuscarPorEmail": "PROCEDURESP_USUARIO_BUSCARPOREMAIL@EMAILVARCHAR(100)ASBEGINSETNOCOUNTONSELECTU.ID_USUARIO,U.ID_ROL,R.NOMBRE_ROL,U.NOMBRE,U.APELLIDO,U.DNI,U.EMAIL,U.CONTRASENA,U.TELEFONO,U.ACTIVO,U.FECHA_ALTAFROMUSUARIOSASUINNERJOINROLESASRONU.ID_ROL=R.ID_ROLWHEREU.EMAIL=@EMAILEND",
    "sp_Usuario_Reactivar": "PROCEDURESP_USUARIO_REACTIVAR@ID_USUARIOINTASBEGINSETNOCOUNTONIF@ID_USUARIOISNULLOR@ID_USUARIO<=0THROW51006,'ELUSUARIONOESVÁLIDO.',1UPDATEUSUARIOSSETACTIVO=1WHEREID_USUARIO=@ID_USUARIOIF@@ROWCOUNT=0THROW51007,'ELUSUARIONOEXISTE.',1END"
  }
